-- Update status dot color function
local function updateStatusDot()
    if batAimbotEnabled then
        statusDot.BackgroundColor3 = Color3.fromRGB(50, 200, 50) -- Green (active)
    else
        statusDot.BackgroundColor3 = Color3.fromRGB(220, 30, 30) -- Red (inactive)
